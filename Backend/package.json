{
  "name": "conversationapp-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time multilingual conversation assistant API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "prisma": "^6.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
